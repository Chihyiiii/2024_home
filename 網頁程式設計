<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>今天吃什麼？選擇困難救星</title>
    <style>
        :root {
            --primary: #ff6b6b;
            --secondary: #4ecdc4;
            --dark: #2d3436;
            --light: #f7f1e3;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light);
            color: var(--dark);
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: var(--dark);
            margin-bottom: 20px;
            text-align: center;
        }

        /* 轉盤容器 */
        .wheel-container {
            position: relative;
            width: 300px;
            height: 300px;
            margin-bottom: 30px;
        }

        /* 實際的轉盤 Canvas */
        #wheelCanvas {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99); /* 旋轉動畫曲線 */
        }

        /* 指針 */
        .pointer {
            position: absolute;
            top: -20px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 15px solid transparent;
            border-right: 15px solid transparent;
            border-top: 30px solid var(--primary);
            z-index: 10;
            filter: drop-shadow(0 2px 2px rgba(0,0,0,0.3));
        }

        /* 控制區 */
        .controls {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            width: 100%;
            max-width: 400px;
        }

        button#spinBtn {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 15px 40px;
            font-size: 1.2rem;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(255, 107, 107, 0.4);
            transition: transform 0.2s, background-color 0.2s;
        }

        button#spinBtn:active {
            transform: scale(0.95);
        }

        button#spinBtn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }

        /* 結果顯示 */
        #result {
            font-size: 1.5rem;
            font-weight: bold;
            height: 40px;
            color: var(--primary);
            text-align: center;
        }

        /* 選項編輯區 */
        .input-group {
            display: flex;
            gap: 10px;
            width: 100%;
        }

        input[type="text"] {
            flex: 1;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
        }

        button#addBtn {
            background-color: var(--secondary);
            color: white;
            border: none;
            padding: 0 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

        /* 選項列表 */
        .item-list {
            list-style: none;
            padding: 0;
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
        }

        .item-tag {
            background: white;
            padding: 5px 10px 5px 15px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            font-size: 0.9rem;
        }

        .delete-btn {
            background: #ff6b6b;
            color: white;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            line-height: 1;
        }
    </style>
</head>
<body>

    <h1>今天吃什麼？</h1>

    <div class="wheel-container">
        <div class="pointer"></div>
        <canvas id="wheelCanvas" width="500" height="500"></canvas>
    </div>

    <div id="result">準備旋轉...</div>

    <div class="controls">
        <button id="spinBtn">開始轉動！</button>
        
        <div class="input-group">
            <input type="text" id="newItem" placeholder="輸入想吃的食物..." onkeypress="handleEnter(event)">
            <button id="addBtn" onclick="addItem()">新增</button>
        </div>

        <ul class="item-list" id="itemList">
            </ul>
    </div>

    <script>
        // 初始化食物清單
        let items = ['拉麵', '火鍋', '義大利麵', '滷肉飯', '麥當勞', '壽司', '牛排', '水餃'];
        
        // 顏色庫 (交替使用)
        const colors = [
            '#FF6B6B', '#4ECDC4', '#45B7D1', '#FFA07A', 
            '#98D8C8', '#F7DC6F', '#BB8FCE', '#F1948A'
        ];

        const canvas = document.getElementById('wheelCanvas');
        const ctx = canvas.getContext('2d');
        const spinBtn = document.getElementById('spinBtn');
        const resultDiv = document.getElementById('result');
        const itemList = document.getElementById('itemList');
        const newItemInput = document.getElementById('newItem');

        let currentRotation = 0;
        let isSpinning = false;

        // 初始化
        function init() {
            drawWheel();
            renderList();
        }

        // 繪製轉盤
        function drawWheel() {
            const numItems = items.length;
            const arcSize = (2 * Math.PI) / numItems;
            const radius = canvas.width / 2;
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            items.forEach((item, index) => {
                const angle = index * arcSize;
                
                // 畫扇形
                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, radius, angle, angle + arcSize);
                ctx.fillStyle = colors[index % colors.length];
                ctx.fill();
                ctx.stroke();

                // 畫文字
                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(angle + arcSize / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = "#fff";
                ctx.font = "bold 24px Arial";
                ctx.fillText(item, radius - 20, 10);
                ctx.restore();
            });
        }

        // 旋轉邏輯
        spinBtn.addEventListener('click', () => {
            if (isSpinning || items.length < 2) {
                if(items.length < 2) alert("至少需要兩個選項才能轉喔！");
                return;
            }

            isSpinning = true;
            resultDiv.innerText = "轉動中...";
            spinBtn.disabled = true;

            // 計算隨機旋轉角度：目前角度 + (最小5圈 360*5) + 隨機角度
            const randomDegree = Math.floor(Math.random() * 360);
            const extraSpins = 360 * 5; 
            const totalDegree = currentRotation + extraSpins + randomDegree;

            // 設定 CSS 旋轉
            canvas.style.transform = `rotate(-${totalDegree}deg)`; // 逆時針旋轉 canvas，視覺上像順時針

            // 等待動畫結束 (配合 CSS transition 4s)
            setTimeout(() => {
                isSpinning = false;
                spinBtn.disabled = false;
                currentRotation = totalDegree; // 更新當前角度以便下次累加
                
                calculateWinner(totalDegree);
            }, 4000);
        });

        // 計算結果
        function calculateWinner(totalDegree) {
            const numItems = items.length;
            const segmentAngle = 360 / numItems;
            
            const effectiveAngle = (totalDegree + 270) % 360;
            
            // 計算這個角度落在第幾個區塊
            const index = Math.floor(effectiveAngle / segmentAngle);

            const winner = items[index];
            resultDiv.innerText = `🎉 今天就吃：${winner}！`;
        }

        // 渲染列表
        function renderList() {
            itemList.innerHTML = '';
            items.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = 'item-tag';
                li.innerHTML = `
                    ${item}
                    <button class="delete-btn" onclick="removeItem(${index})">×</button>
                `;
                itemList.appendChild(li);
            });
        }

        // 新增項目
        function addItem() {
            const val = newItemInput.value.trim();
            if (val) {
                items.push(val);
                newItemInput.value = '';
                drawWheel();
                renderList();
            }
        }

        // 刪除項目
        function removeItem(index) {
            if (items.length <= 2) {
                alert("至少要保留兩個選項喔！");
                return;
            }
            items.splice(index, 1);
            drawWheel();
            renderList();
        }

        // 處理 Enter 鍵
        function handleEnter(e) {
            if (e.key === 'Enter') addItem();
        }

        // 啟動
        init();
        
        // 視窗大小改變時重繪 (保持清晰度)
        window.onresize = drawWheel;

    </script>
</body>
</html>
